# ============================================
# OTTO — Environment Variables
# ============================================
# העתק לקובץ `.env.local` לפיתוח, וקבע ב-Vercel Dashboard ל-production.
# כל המשתנים עם NEXT_PUBLIC_ נחשפים ל-client. השאר server-only.

# --------------------------------------------
# Supabase
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx     # ⚠ server-only — לעולם לא להחשיף ב-client
SUPABASE_PROJECT_ID=xxxxx                # לcommands של supabase CLI

# --------------------------------------------
# App URLs
# --------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.otto-ai.co.il
NEXT_PUBLIC_PORTAL_URL=https://clients.otto-ai.co.il
NEXT_PUBLIC_TENANT_SLUG=otto              # לזיהוי tenant בשלב single-tenant

# --------------------------------------------
# Authentication
# --------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxx
NEXTAUTH_SECRET=xxxxx                     # generate: openssl rand -base64 32

# --------------------------------------------
# AI Providers
# --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxx
GOOGLE_AI_API_KEY=xxxxx                   # Gemini fallback
OPENAI_API_KEY=sk-xxxxx                   # רק לembeddings (text-embedding-3-small)

# --------------------------------------------
# WhatsApp (Green API)
# --------------------------------------------
GREEN_API_INSTANCE_ID=xxxxx
GREEN_API_TOKEN=xxxxx
GREEN_API_BASE_URL=https://api.green-api.com
WHATSAPP_WEBHOOK_SECRET=xxxxx             # token לוולידציה של webhooks נכנסים

# --------------------------------------------
# Finbot (חשבוניות)
# --------------------------------------------
FINBOT_API_TOKEN=xxxxx
FINBOT_BUSINESS_ID=xxxxx
FINBOT_WEBHOOK_SECRET=xxxxx

# --------------------------------------------
# Make.com Webhooks
# --------------------------------------------
# כל webhook ב-Make = URL ייחודי שאנחנו קוראים אליו
MAKE_WEBHOOK_FINBOT_INVOICE=https://hook.eu1.make.com/xxxxx
MAKE_WEBHOOK_WHATSAPP_SEND=https://hook.eu1.make.com/xxxxx
MAKE_WEBHOOK_ZOOM_PROCESS=https://hook.eu1.make.com/xxxxx
MAKE_WEBHOOK_RUNPOD_TRANSCRIBE=https://hook.eu1.make.com/xxxxx
MAKE_WEBHOOK_SECRET=xxxxx                 # token משותף לוולידציה

# --------------------------------------------
# Zoom
# --------------------------------------------
ZOOM_ACCOUNT_ID=xxxxx
ZOOM_CLIENT_ID=xxxxx
ZOOM_CLIENT_SECRET=xxxxx
ZOOM_WEBHOOK_SECRET_TOKEN=xxxxx           # ל-event subscription validation

# --------------------------------------------
# Google APIs (Drive + Calendar)
# --------------------------------------------
# OAuth credentials נפרדים מ-Google login (אותו project, scopes שונים)
GOOGLE_API_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_API_CLIENT_SECRET=xxxxx
GOOGLE_DRIVE_ROOT_FOLDER_ID=xxxxx         # תיקיית root לכל פרויקט
GOOGLE_CALENDAR_ID=primary                # או ID ספציפי

# --------------------------------------------
# RunPod (תמלול ivrit-ai)
# --------------------------------------------
RUNPOD_API_KEY=xxxxx
RUNPOD_ENDPOINT_ID=xxxxx                  # endpoint של ivrit-ai/whisper
RUNPOD_WEBHOOK_URL=https://app.otto-ai.co.il/api/webhooks/transcription-completed

# --------------------------------------------
# Push Notifications (PWA)
# --------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx                   # generate: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:uri@otto-ai.co.il

# --------------------------------------------
# Email Sending (Resend)
# --------------------------------------------
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=OTTO <noreply@otto-ai.co.il>
EMAIL_REPLY_TO=uri@otto-ai.co.il

# --------------------------------------------
# Monitoring
# --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxx            # לupload של source maps
SENTRY_ORG=otto
SENTRY_PROJECT=otto-app

# --------------------------------------------
# GitHub Actions (Maintenance Bot)
# --------------------------------------------
# מוגדרים ב-GitHub Repo Settings → Secrets, לא בקובץ הזה:
# - ANTHROPIC_API_KEY (אותו key)
# - VERCEL_TOKEN (לdeploy אם נדרש)
# - GH_PAT (Personal Access Token לפתיחת PRs)

# --------------------------------------------
# Future / Optional
# --------------------------------------------
# CLOUDFLARE_R2_ACCOUNT_ID=                # אם נעבור ל-R2 בעתיד
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=otto-recordings
#
# ACTIVECAMPAIGN_API_KEY=                  # כשנשלב CRM נוסף
# ACTIVECAMPAIGN_API_URL=
#
# RAV_MESSER_TOKEN=                        # רב מסר (SMS)

# --------------------------------------------
# Development only
# --------------------------------------------
NODE_ENV=development                      # production ב-Vercel אוטומטית
NEXT_TELEMETRY_DISABLED=1
