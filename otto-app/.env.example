# OTTO ERP/CRM - environment variables actually used in code (names only, never commit values).
# Copy to .env.local and fill in. Production values live in Vercel (npx vercel env ls).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=

# Encryption (two SEPARATE keys - do NOT unify without a re-encryption migration)
ENCRYPTION_KEY=                  # 32-byte hex - Google Calendar token encryption (lib/google-calendar.ts)
CREDENTIALS_ENCRYPTION_KEY=      # AES-256-GCM - customer credentials vault (credentials-actions.ts)

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Webhooks / cron secrets
CRON_SECRET=                     # protects /api/cron/* (timingSafeEqual)
MAKE_INBOUND_SECRET=             # inbound Make webhooks
RECORDINGS_WEBHOOK_SECRET=       # recordings transcription webhook (HMAC)

# External APIs
ANTHROPIC_API_KEY=               # recording summaries
RUNPOD_API_KEY=                  # ivrit-ai transcription

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
